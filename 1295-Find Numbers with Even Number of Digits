class Solution {
public:
    int findNumbers(vector<int>& nums) {
        int n=0;
        for(int i=0;i<nums.size();i++){
            int count=0;
            int v=nums[i];
            while(v>0){
                count++;
                v/=10;
            }
            if(count%2==0){
                n++;
            }
        }
        return n;
    }
};
